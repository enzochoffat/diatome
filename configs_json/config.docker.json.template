{
  "metadata": {
    "name": "FIBE Docker Configuration",
    "description": "Container-ready config with environment variable substitution",
    "version": "0.1.0",
    "created": "2026-01-25"
  },
  "simulation": {
    "verbose": true,
    "random_seed": null,
    "step": 1,
    "coupling": false,
    "duration_years": 10,
    "start_date": "2006-01-01"
  },
  "agents": {
    "num_agents": {
      "num_archipelago": 5,
      "num_coastal": 5,
      "num_trawler": 2
    },
    "names": [
      "a", "b", "c", "d", "e", "f", "g", "h", "i", "j",
      "k", "l", "m", "n", "o", "p", "q", "r", "s", "t",
      "u", "v", "w", "x", "y"
    ],
    "archipelago_ports": [1, 1, 1, 1, 1, 1, 1, 1, 1, 2, 0],
    "coastal_ports": [2, 2, 2, 2, 2, 2, 2, 2, 2, 2, 2],
    "trawler_ports": [0, 0, 0, 0, 0],
    "archipelago_habitats": [],
    "coastal_habitats": [],
    "trawler_habitats": [],
    "archipelagos_wave_height": 2,
    "coastal_wave_height": 2,
    "trawler_wave_height": 2
  },
  "output": {
    "export_data": true,
    "filename_prefix": "fibe_output",
    "export_interval_years": 1
  },
  "parameters": {
    "fish_dynamics": {
      "growth_rate": 0.1,
      "initial_stock_ratio": 0.5,
      "initial_stock_size": "halfCarryingCap"
    },
    "economics": {
      "fish_price": 1.0,
      "initial_capital": 1000.0
    },
    "weather": {
      "bad_weather_probability": 0.1
    }
  },
  "maps": {
    "spatial_extent": {
      "west": 3.0,
      "north": 42.4,
      "cell_size_deg": 0.0202
    },
    "restricted_area_map": {},
    "restricted_area_vector": "${RESTRICTED_AREA_VECTOR}",
    "ocean_current_map": "${OCEAN_CURRENT_MAP}",
    "wave_height_vector": "${WAVE_HEIGHT_VECTOR}",
    "wind_farm_map": "${WINDFARM_MAP}",
    "species_tables": {
      "price": null,
      "catchability": null
    },
    "species_map": {},
    "spatial_map": "${TOPOLOGY_MAP}",
    "ports_map": "${PORTS_MAP}",
    "habitat_map": {}
  },
  "quotas": {
    "effort": null,
    "landings": null
  }
}